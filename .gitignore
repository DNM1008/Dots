# Whitelist approach: ignore everything under .config and .local by
# default, then explicitly un-ignore the paths we actually want tracked.
# When adding something new, add a matching !-rule here — otherwise it
# stays untracked even after the .config/.local symlink is in place.

*.pyc
.env

# ---- .config -----------------------------------------------------------
.config/*

!.config/alacritty
!.config/autostart
!.config/bash
!.config/breezerc
!.config/btop
!.config/byobu
!.config/environment.d
!.config/exo
!.config/fastfetch
!.config/fcitx5
!.config/flameshot
!.config/fontconfig
!.config/foot
!.config/ghostty
!.config/gtk-2.0
!.config/gtk-3.0
!.config/gtk-4.0
!.config/htop
!.config/ipython
!.config/KDE
!.config/kded5rc
!.config/kded6rc
!.config/kdedefaults
!.config/kdeglobals
!.config/kglobalshortcutsrc
!.config/khotkeysrc
!.config/kitty
!.config/krohnkite
!.config/kscreenlockerrc
!.config/kservicemenurc
!.config/ktrashrc
!.config/kwinrc
!.config/kwinrulesrc
!.config/kxkbrc
!.config/lazygit
!.config/mimeapps.list
!.config/nvim
!.config/pandoc
!.config/pavucontrol.ini
!.config/pavucontrol-qt
!.config/peazip
!.config/pip
!.config/plasma-localerc
!.config/plasma-org.kde.plasma.desktop-appletsrc
!.config/plasmanotifyrc
!.config/plasmaparc
!.config/plasma-workspace
!.config/plasmarc
!.config/plasmashellrc
!.config/powerdevilrc
!.config/powermanagementprofilesrc
!.config/qt5ct
!.config/qt6ct
!.config/qtile
!.config/QtProject.conf
!.config/reflector-simple-free-params.txt
!.config/spectacle.notifyrc
!.config/spectaclerc
!.config/starship.toml
!.config/systemd
!.config/Thunar
!.config/user-dirs.dirs
!.config/user-dirs.locale
!.config/wgetrc
!.config/wofi
!.config/xdg-terminals.list
!.config/xsettingsd
!.config/zsh

# ---- .local --------------------------------------------------------------
.local/*
!.local/bin
!.local/share

.local/share/*
!.local/share/applications
!.local/share/color-schemes
!.local/share/pandoc

# .local/state is entirely runtime state/history — stays fully ignored.
